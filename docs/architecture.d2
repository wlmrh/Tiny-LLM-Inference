vars: {
  d2-config: {
    layout-engine: elk
    theme-id: 301
  }
}

direction: right

classes: {
  class_box: {
    shape: rectangle
    width: 240
    height: 72
    style: {
      fill: "#FFFFFF"
      stroke: "#64748B"
      stroke-width: 1
      border-radius: 8
      font-color: "#0F172A"
    }
  }
  core_class: {
    shape: rectangle
    width: 240
    height: 72
    style: {
      fill: "#EFF6FF"
      stroke: "#2563EB"
      stroke-width: 1
      border-radius: 8
      font-color: "#0F172A"
    }
  }
  memory_class: {
    shape: rectangle
    width: 240
    height: 72
    style: {
      fill: "#F0FDF4"
      stroke: "#16A34A"
      stroke-width: 1
      border-radius: 8
      font-color: "#0F172A"
    }
  }
  model_class: {
    shape: rectangle
    width: 240
    height: 72
    style: {
      fill: "#FFF7ED"
      stroke: "#EA580C"
      stroke-width: 1
      border-radius: 8
      font-color: "#0F172A"
    }
  }
  interface_class: {
    shape: rectangle
    width: 240
    height: 72
    style: {
      fill: "#F8FAFC"
      stroke: "#334155"
      stroke-width: 1
      stroke-dash: 4
      border-radius: 8
      font-color: "#0F172A"
    }
  }
  owns: {
    style: {
      stroke: "#2563EB"
      stroke-width: 2
    }
  }
  uses: {
    style: {
      stroke: "#64748B"
      stroke-dash: 3
    }
  }
  memory: {
    style: {
      stroke: "#16A34A"
      stroke-width: 2
    }
  }
}

LLM.class: core_class
HFLlamaTokenizer.class: class_box
StackAllocator.class: memory_class
LLMEngine.class: core_class
EngineCore.class: core_class
Scheduler.class: core_class
KVCache.class: memory_class
ModelRunner.class: core_class
ExecutionContext.class: class_box
RuntimeContext.class: class_box
Model: "Model interface"
Model.class: interface_class
LlamaForCausalLM.class: model_class

LLM -> LLMEngine: "owns" {class: owns}
LLM -> HFLlamaTokenizer: "owns" {class: owns}
LLM -> StackAllocator: "owns" {class: owns}
LLMEngine -> EngineCore: "owns" {class: owns}
LLMEngine -> HFLlamaTokenizer: "uses" {class: uses}

EngineCore -> Scheduler: "owns" {class: owns}
EngineCore -> ModelRunner: "owns" {class: owns}

Scheduler -> KVCache: "owns or binds" {class: memory}
ModelRunner -> KVCache: "uses" {class: uses}
ModelRunner -> ExecutionContext: "initializes" {class: uses}
ExecutionContext -> StackAllocator: "uses" {class: uses}
ExecutionContext -> KVCache: "uses" {class: uses}
ModelRunner -> RuntimeContext: "builds per step" {class: uses}
RuntimeContext -> ExecutionContext: "references" {class: uses}

ModelRunner -> Model: "owns or references" {class: owns}
LlamaForCausalLM -> Model: "implements" {class: uses}
